        "expectedResults": [
          "Item is created successfully with source_language='fr'",
          "5 translation jobs are queued (en, es, de, nl, it)",
          "API response includes array of 5 translationJobIds",
          "Translation jobs have status='queued' in translation_jobs table",
          "Jobs have priority=100 (recently created content)"
        ]
      },
