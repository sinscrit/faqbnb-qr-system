          "1.2",
          "1.3"
        ],
        "steps": [
          "1. Admin user logs in with French (fr) as preferred language",
          "2. Navigate to Items management",
          "3. Create new item with name='Machine \u00e0 caf\u00e9' and description='Cafeti\u00e8re automatique avec broyeur'",
