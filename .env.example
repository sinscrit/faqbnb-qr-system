# Browser-visible P0 configuration (non-working examples)
NEXT_PUBLIC_SUPABASE_URL=https://example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-a-local-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_QR_DOMAIN_OVERRIDE=

# Server-only P0 configuration (non-working examples)
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-local-service-role-key
SYSADMIN_EMAILS=
PORT=3000

# Optional observability configuration
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Deferred/P1 provider configuration; leave unset for P0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TRANSLATION_SERVICE_TOKEN=

# Existing Google identities only; leave unset for core P0. Set server-side only
# during deliberate compatibility verification after provider redirect and
# rotation configuration is prepared, then verify the callback in staging.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
